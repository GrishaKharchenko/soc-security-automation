# ============================================================================
#  IOC Analyzer — пример конфигурации.
#  Скопируйте в .env:  cp .env.example .env   (.env НИКОГДА не коммитится)
# ============================================================================

# --- VirusTotal ------------------------------------------------------------
# Ключ API v3. Получить: https://www.virustotal.com/gui/my-apikey
VT_API_KEY=
VT_BASE_URL=https://www.virustotal.com/api/v3

# Лимит публичного ключа VirusTotal: 4 запроса/мин, 500/сутки.
# Для премиум-ключа поднимите значение.
VT_REQUESTS_PER_MINUTE=4

# Сетевые параметры
VT_TIMEOUT=20                 # таймаут одного HTTP-запроса, сек
VT_MAX_RETRIES=3              # повторы при 429/5xx/таймаутах
VT_BACKOFF_FACTOR=2.0         # экспоненциальная пауза: backoff * 2**attempt

# --- Пороги вердикта -------------------------------------------------------
# Сколько антивирусов должны сказать "malicious", чтобы вердикт = MALICIOUS
VERDICT_MALICIOUS_THRESHOLD=3
# Сколько "suspicious" (или 1 malicious) достаточно для вердикта SUSPICIOUS
VERDICT_SUSPICIOUS_THRESHOLD=2
# Репутация VT ниже этого значения сама по себе делает IOC подозрительным
VERDICT_REPUTATION_FLOOR=-20

# --- Вывод и логирование ---------------------------------------------------
OUTPUT_DIR=reports
LOG_LEVEL=INFO                # DEBUG | INFO | WARNING | ERROR
LOG_FILE=logs/ioc_analyzer.log
LOG_MAX_BYTES=1048576         # ротация лога: 1 МБ
LOG_BACKUP_COUNT=3

# --- Кеш -------------------------------------------------------------------
# Кеш ответов VT, чтобы не сжигать квоту на повторных запусках
CACHE_ENABLED=true
CACHE_FILE=.cache/vt_cache.json
CACHE_TTL=86400               # срок жизни записи кеша, сек (24 часа)
