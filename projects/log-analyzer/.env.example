# ============================================================================
#  SOC Log Analyzer — пример конфигурации.
#  Скопируйте в .env:  cp .env.example .env
# ============================================================================

# --- Разбор логов ----------------------------------------------------------
# Syslog-формат (auth.log) не содержит года и часового пояса. Указываем явно,
# иначе корреляция событий по времени будет врать.
LOG_TIMEZONE=UTC              # часовой пояс исходных логов, напр. Europe/Moscow
LOG_DEFAULT_YEAR=             # год для записей auth.log; пусто = из mtime файла

# --- Детект brute force (T1110.001) ---------------------------------------
# Много неудач по ОДНОЙ учётной записи с ОДНОГО адреса.
BRUTEFORCE_THRESHOLD=5        # сколько неудач подряд считать атакой
BRUTEFORCE_WINDOW=300         # окно наблюдения, сек

# --- Детект password spraying (T1110.003) ---------------------------------
# Мало попыток по МНОГИМ учётным записям с одного адреса.
SPRAYING_MIN_USERS=5          # сколько разных логинов перебирает источник
SPRAYING_MAX_ATTEMPTS_PER_USER=3   # не более стольких попыток на логин
SPRAYING_WINDOW=1800          # окно наблюдения, сек

# --- Успешный вход после серии неудач (T1078) -----------------------------
SUCCESS_AFTER_FAILURES_MIN=3  # сколько неудач должно предшествовать успеху
SUCCESS_AFTER_FAILURES_WINDOW=600

# --- Перебор имён пользователей (T1087) -----------------------------------
ENUMERATION_MIN_INVALID_USERS=5    # неизвестных логинов с одного адреса
ENUMERATION_WINDOW=600

# --- Распределённая атака на одну учётную запись --------------------------
DISTRIBUTED_MIN_SOURCES=3     # с какого числа разных IP считать распределённой
DISTRIBUTED_WINDOW=1800

# --- Аномалии по времени ---------------------------------------------------
BUSINESS_HOURS_START=8        # начало рабочего дня (час, 0-23)
BUSINESS_HOURS_END=20         # конец рабочего дня
FLAG_WEEKEND_LOGINS=true      # помечать входы в выходные

# --- Злоупотребление sudo (T1548.003) -------------------------------------
SUDO_FAILURE_THRESHOLD=3
SUDO_FAILURE_WINDOW=600

# --- Вывод и логирование ---------------------------------------------------
OUTPUT_DIR=reports
LOG_LEVEL=INFO
LOG_FILE=logs/log_analyzer.log
LOG_MAX_BYTES=1048576
LOG_BACKUP_COUNT=3
