# ============================================================================
#  SOC Automation Toolkit — конфигурация оболочки.
#  Копировать в .env:  cp .env.example .env
#
#  ВАЖНО: у каждого модуля набора свой .env со своими настройками.
#  Ключ VirusTotal задаётся в projects/ioc-analyzer/.env,
#  пороги детектов — в projects/log-analyzer/.env.
#  Здесь только параметры самой оболочки.
# ============================================================================

TOOLKIT_OUTPUT_DIR=reports
TOOLKIT_LOG_FILE=logs/soc_toolkit.log
LOG_LEVEL=INFO
LOG_MAX_BYTES=1048576
LOG_BACKUP_COUNT=3

# Повышать критичность находок, подтверждённых несколькими инструментами
ESCALATE_CROSS_TOOL=true
